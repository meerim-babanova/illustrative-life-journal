# Copy this file to .env and fill in real values. .env is gitignored and
# must NEVER be committed or shipped to the Flutter client.

# Required: your OpenAI API key. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: which image provider to use.
# - "openai" (default): calls the real OpenAI Images API. Requires
#   OPENAI_API_KEY to be set.
# - "mock": returns a static placeholder illustration with no external
#   calls or credentials — useful for local UI development/testing.
IMAGE_PROVIDER=openai

# Optional: port the server listens on.
PORT=8787

# Optional but recommended for production: restrict CORS to your actual
# deployed Flutter web app's origin instead of the dev default ("*").
ALLOWED_ORIGIN=*
